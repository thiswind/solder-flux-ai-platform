# 云锡演示部署 compose 环境变量（复制为同目录 .env 后填写）
# SSO 签发密钥（与源码包根 .env 的 PORTAL_SECRET_KEY 一致；compute/data 靠它验签门户令牌）
PORTAL_SECRET_KEY=change-me-copy-from-source-env
PORTAL_TOKEN_HOURS=12
# PostgreSQL 容器口令（自定，首次初始化后生效）
YUNXI_PG_PASSWORD=change-me-pg-password
# 前端访问源（CORS 用，逗号分隔）
YUNXI_PUBLIC_ORIGINS=http://10.50.2.92
# 镜像（默认走 campus-registry；构建期可用 YUNXI_IMAGE=yunxi-platform:dev 本地跑）
YUNXI_IMAGE=10.50.2.92:15000/yunxi/platform:latest
