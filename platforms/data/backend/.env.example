APP_NAME=锡基材料数据管理与可视化平台
APP_ENV=development
API_V1_PREFIX=/api/v1
# PROJECT_ROOT 指向“原始数据项目”根目录（本仓库内为 ./processed_data）。
# 注意：代码内部会把上传/输出目录定位到同级 platform 目录，克隆后请按实际路径调整。
PROJECT_ROOT=./processed_data
# 密码只是占位符，请改为你自己的数据库密码（.env 本身不入库）
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/yunxi_management_db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
