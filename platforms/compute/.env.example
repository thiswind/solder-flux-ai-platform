# 锡膏智能计算平台 - 环境变量示例
# 用法：复制本文件为同目录下的 .env，并填入你自己环境的真实值。
#       .env 已被 .gitignore 忽略，不会上传到 GitHub。
#       注意：DATABASE_URL 里的密码只是占位符，请改成你自己的数据库密码。

# 数据库连接（PostgreSQL）
# 格式: postgresql://用户名:密码@地址:端口/数据库名
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/yunxi_db

# CORS 跨域配置（逗号分隔，生产环境改为前端实际域名）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 项目设置
PROJECT_NAME=Yunxi_Platform
VERSION=0.1.0
